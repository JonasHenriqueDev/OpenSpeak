[Unit]
Description=OpenSpeak monitoring dashboard
After=network.target openspeak.service

[Service]
User=openspeak
Group=openspeak
ExecStart=/usr/bin/python3 /opt/openspeak-monitor/monitor.py
Environment=OPENSPEAK_METRICS_FILE=/run/openspeak/metrics.json
Environment=OPENSPEAK_PASSWORD_FILE=/var/lib/openspeak-monitor/server-password
Environment=OPENSPEAK_PROFILES_FILE=/var/lib/openspeak/profiles.json
ReadWritePaths=-/var/lib/openspeak
Environment=MONITOR_TIMEZONE=America/Sao_Paulo
EnvironmentFile=-/etc/openspeak-monitor.env
StateDirectory=openspeak-monitor
StateDirectoryMode=0750
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
