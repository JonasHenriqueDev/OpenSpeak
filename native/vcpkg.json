{
  "name": "openspeak-native",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "libdatachannel",
      "default-features": false,
      "features": ["srtp"]
    }
  ],
  "default-features": ["client"],
  "features": {
    "client": {
      "description": "Cliente desktop: FFmpeg para codificar/decodificar vídeo. Um build só do servidor (relay SFU) dispensa.",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": ["avcodec", "swscale", "swresample", "nvcodec", "amf", "qsv", "openh264", "dav1d", "opus"]
        }
      ]
    }
  }
}
